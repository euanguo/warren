{
  "name": "warren",
  "productName": "Warren",
  "version": "0.3.2",
  "description": "Agent-first isolated browser environments — one burrow per identity, one egress per burrow",
  "license": "MIT",
  "homepage": "https://github.com/saywhy-dev/warren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saywhy-dev/warren.git"
  },
  "type": "module",
  "main": ".vite/build/main.cjs",
  "bin": {
    "warren": "bin/warren.mjs"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test:unit": "node --test \"tests/*.test.ts\"",
    "test:ui": "vitest run",
    "test:changed": "node ./scripts/test-changed.mjs",
    "test": "npm run test:unit && npm run test:ui",
    "check:changed": "npm run lint && npm run format:check && npm run typecheck && npm run test:changed",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && node node_modules/vite/bin/vite.js build --config vite.renderer.config.mjs",
    "ui:promote": "node ./scripts/ui-promote.mjs",
    "ui:diff": "diff -ru src/renderer/components/ui-reference src/renderer/components/ui || true",
    "postinstall": "node ./scripts/electron-name.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kubai-icons": "^0.16.1",
    "kubai-icons-react": "^0.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "electron": "45.5.0",
    "happy-dom": "^21.0.4",
    "oxlint": "1.95.0",
    "prettier": "^3.10.1",
    "shadcn": "^4.23.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "config": {
    "forge": "forge.config.cjs"
  }
}
