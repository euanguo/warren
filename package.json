{
  "name": "warren",
  "productName": "Warren",
  "version": "0.1.0",
  "description": "Agent-first isolated browser environments — one burrow per identity, one egress per burrow",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "bin": {
    "warren": "bin/warren.mjs"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "ui:promote": "node ./scripts/ui-promote.mjs",
    "ui:diff": "diff -ru src/renderer/components/ui-reference src/renderer/components/ui || true",
    "postinstall": "node ./scripts/electron-name.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@electron-forge/cli": "latest",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "latest",
    "@electron-forge/plugin-vite": "latest",
    "@electron/fuses": "latest",
    "@electron/notarize": "^3.1.2",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "44.7.0",
    "oxlint": "1.88.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.5",
    "tailwindcss": "latest",
    "tw-animate-css": "latest",
    "typescript": "7.0.2",
    "vite": "latest"
  },
  "config": {
    "forge": "forge.config.cjs"
  }
}
