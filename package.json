{
  "name": "warren",
  "productName": "Warren",
  "version": "0.1.0",
  "description": "Agent-first isolated browser environments — one burrow per identity, one egress per burrow",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "bin": {
    "warren": "bin/warren.mjs"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && node node_modules/vite/bin/vite.js build --config vite.renderer.config.mjs",
    "ui:promote": "node ./scripts/ui-promote.mjs",
    "ui:diff": "diff -ru src/renderer/components/ui-reference src/renderer/components/ui || true",
    "postinstall": "node ./scripts/electron-name.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "electron": "45.5.0",
    "oxlint": "1.95.0",
    "prettier": "^3.10.1",
    "shadcn": "^4.23.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.4.0"
  },
  "config": {
    "forge": "forge.config.cjs"
  }
}
