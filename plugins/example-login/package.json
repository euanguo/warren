{
  "name": "warren-plugin-example-login",
  "version": "0.3.0",
  "private": true,
  "description": "本地 fixture 的登录插件：演示权限声明、Vault.fill、设置描述符与环境菜单动作。",
  "files": [
    "server.js"
  ],
  "warren": {
    "id": "com.example.login",
    "name": "Example Login",
    "apiVersion": "4",
    "runtime": "sandbox",
    "server": "server.js",
    "engines": {
      "warren": ">=0.1.0"
    },
    "permissions": [
      "environment.read",
      "browser.dom.read",
      "browser.navigate",
      "browser.input",
      "vault.fill",
      "ui.mount",
      "storage.write"
    ],
    "contributes": {
      "commands": [
        {
          "name": "login",
          "summary": "用 Vault 里的凭据登录当前环境"
        },
        {
          "name": "status",
          "summary": "看当前环境是否已登录"
        },
        {
          "name": "logout",
          "summary": "清掉插件记住的登录状态"
        }
      ],
      "settings": [
        {
          "key": "baseUrl",
          "type": "string",
          "label": "登录页地址",
          "description": "不填就用内置的本地 fixture",
          "default": "http://127.0.0.1:8899/login.html"
        }
      ],
      "surfaces": [
        {
          "kind": "envAction",
          "id": "login",
          "title": "用插件登录",
          "icon": "KeyRound",
          "command": "login"
        }
      ]
    }
  }
}
