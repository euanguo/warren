{
  "name": "warren-plugin-example-notes",
  "version": "0.5.0",
  "private": true,
  "description": "agent 的外置记忆：待办与事实，按环境或全局存储，能搜、能给上下文摘要。",
  "files": [
    "server.js",
    "app.js"
  ],
  "warren": {
    "id": "com.example.notes",
    "name": "记忆",
    "apiVersion": "4",
    "runtime": "sandbox",
    "server": "server.js",
    "app": "app.js",
    "icon": "List",
    "engines": {
      "warren": ">=0.1.0"
    },
    "permissions": [
      "environment.read",
      "browser.dom.read",
      "storage.write",
      "rpc.serve",
      "ui.mount"
    ],
    "contributes": {
      "commands": [
        {
          "name": "context",
          "summary": "这个环境现在该干什么 + 已经知道什么（给 agent 的压缩摘要）"
        },
        {
          "name": "add",
          "summary": "记一条：--input='{\"kind\":\"todo\",\"title\":\"…\",\"tags\":\"a,b\",\"priority\":2}'"
        },
        {
          "name": "list",
          "summary": "列出条目；可加 --input='{\"kind\":\"todo\",\"status\":\"open\",\"tag\":\"x\"}'"
        },
        {
          "name": "search",
          "summary": "按关键词搜标题 / 正文 / 标签：--input='{\"query\":\"登录\"}'"
        },
        {
          "name": "update",
          "summary": "改标题 / 正文 / 标签 / 优先级：--input='{\"id\":1,\"body\":\"…\"}'"
        },
        {
          "name": "setStatus",
          "summary": "待办流转：--input='{\"id\":1,\"status\":\"doing|done|dropped\"}'"
        },
        {
          "name": "remove",
          "summary": "删一条：--input='{\"id\":1}'"
        },
        {
          "name": "remember",
          "summary": "把当前页面记成一条记忆（标题与 URL 自动带上）"
        },
        {
          "name": "clear",
          "summary": "清空全部"
        }
      ],
      "settings": [
        {
          "key": "title",
          "type": "string",
          "label": "面板标题",
          "default": "记忆"
        },
        {
          "key": "filter",
          "type": "select",
          "label": "默认过滤",
          "options": [
            "all",
            "local",
            "remote"
          ],
          "default": "all"
        },
        {
          "key": "apiKey",
          "type": "secret",
          "label": "同步用 API Key",
          "description": "存进 Vault，插件前端永远看不到它"
        }
      ],
      "surfaces": [
        {
          "kind": "railPage",
          "id": "notes",
          "title": "记忆",
          "icon": "List",
          "path": "notes"
        },
        {
          "kind": "settingsSection",
          "id": "about",
          "title": "记忆使用说明"
        },
        {
          "kind": "inspectorTab",
          "id": "page",
          "title": "记忆"
        },
        {
          "kind": "envBadge",
          "id": "todos",
          "title": "待办数",
          "icon": "List"
        },
        {
          "kind": "envAction",
          "id": "add",
          "title": "记一条",
          "icon": "List",
          "command": "remember"
        }
      ],
      "rpc": [
        "list",
        "context",
        "add",
        "update",
        "setStatus",
        "remove",
        "remember",
        "stats"
      ]
    }
  }
}
